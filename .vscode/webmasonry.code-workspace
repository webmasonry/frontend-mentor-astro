{
  "extensions": {
    "recommendations": [],
    "unwantedRecommendations": []
  },
  "folders": [
    {
      "path": ".."
    }
  ],
  "launch": {
    "compounds": [
      {
        "configurations": ["astro-dev", "astro-browser"],
        "name": "astro"
      }
    ],
    "configurations": [
      {
        "command": "npm run dev",
        "cwd": "${fileWorkspaceFolder}",
        "name": "astro-dev",
        "request": "launch",
        "type": "node-terminal"
      },
      {
        "name": "astro-browser",
        "request": "launch",
        "sourceMaps": true,
        "type": "editor-browser",
        "url": "http://localhost:4321",
        "webRoot": "${fileWorkspaceFolder}"
      }
    ],
    "version": "0.2.0"
  },
  "settings": {
    "[astro]": {
      "editor.defaultFormatter": "biomejs.biome"
    },
    "[css]": {
      "editor.defaultFormatter": "biomejs.biome"
    },
    "[javascript]": {
      "editor.defaultFormatter": "biomejs.biome"
    },
    "[json]": {
      "editor.defaultFormatter": "biomejs.biome"
    },
    "[jsonc]": {
      "editor.defaultFormatter": "biomejs.biome"
    },
    "[typescript]": {
      "editor.defaultFormatter": "biomejs.biome"
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "biomejs.biome"
    },
    "[vue]": {
      "editor.defaultFormatter": "biomejs.biome"
    },
    "biome.enabled": true,
    "biome.lsp.trace.server": "off",
    "chat.checkpoints.enabled": true,
    "chat.checkpoints.showFileChanges": true,
    "chat.editing.autoAcceptDelay": 0,
    "chat.editing.explainChanges.enabled": true,
    "chat.editing.openChangedFileInDiffEditor": true,
    "chat.editing.revealNextChangeOnResolve": true,
    "chat.tools.compressOutput.enabled": true,
    "chat.tools.confirmationCarousel.enabled": true,
    "chat.tools.todos.showWidget": true,
    "chat.viewSessions.orientation": "stacked",
    "css.lint.unknownAtRules": "ignore",
    "debug.toolBarLocation": "commandCenter",
    "editor.codeActionsOnSave": {
      "source.addMissingImports.ts": "never",
      "source.biome": "explicit",
      "source.fixAll": "never",
      "source.fixAll.biome": "explicit",
      "source.fixAll.prettier": "never",
      "source.fixAll.sortJSON": "never",
      "source.fixAll.ts": "never",
      "source.organizeImports": "never",
      "source.organizeImports.biome": "explicit",
      "source.removeUnused.ts": "never",
      "source.removeUnusedImports": "never",
      "source.sort.json": "never",
      "source.sortImports": "never"
    },
    "editor.colorDecorators": true,
    "editor.detectIndentation": false,
    "editor.fontFamily": "FiraCode Nerd Font",
    "editor.fontLigatures": true,
    "editor.fontSize": 14,
    "editor.formatOnPaste": false,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.formatOnType": false,
    "editor.lightbulb.enabled": "onCode",
    "editor.minimap.enabled": false,
    "editor.renderWhitespace": "all",
    "editor.rulers": [80],
    "editor.tabSize": 2,
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 80,
    "emmet.includeLanguages": {
      "astro": "html",
      "svelte": "html",
      "vue": "html"
    },
    "evenBetterToml.schema.associations": {
      "alacritty\\.toml$": "https://githubusercontent.com"
    },
    "explorer.compactFolders": false,
    "explorer.confirmDelete": false,
    "figma.autocompleteBlocks": true,
    "figma.autocompleteProperties": true,
    "files.associations": {
      "**/i3/config": "i3",
      "**/i3blocks/config": "i3",
      "**/i3status/config": "i3"
    },
    "github.copilot.enable": {
      "*": false,
      "**/.astro/**": false,
      "**/.drizzle/**": false,
      "**/.wrangler/**": false,
      "**/build/**": false,
      "**/dist/**": false,
      "**/node_modules/**": false,
      "markdown": false,
      "plaintext": false,
      "scminput": false
    },
    "github.copilot.nextEditSuggestions.enabled": true,
    "js/ts.autoClosingTags.enabled": true,
    "js/ts.format.enabled": true,
    "js/ts.implementationsCodeLens.enabled": false,
    "js/ts.implementationsCodeLens.showOnAllClassMethods": false,
    "js/ts.inlayHints.enumMemberValues.enabled": false,
    "js/ts.inlayHints.functionLikeReturnTypes.enabled": false,
    "js/ts.inlayHints.parameterNames.enabled": "none",
    "js/ts.inlayHints.parameterNames.suppressWhenArgumentMatchesName": false,
    "js/ts.inlayHints.parameterTypes.enabled": false,
    "js/ts.inlayHints.propertyDeclarationTypes.enabled": false,
    "js/ts.inlayHints.variableTypes.enabled": false,
    "js/ts.inlayHints.variableTypes.suppressWhenTypeMatchesName": false,
    "js/ts.suggest.autoImports": true,
    "js/ts.suggest.classMemberSnippets.enabled": true,
    "js/ts.suggest.enabled": true,
    "js/ts.suggest.jsdoc.enabled": true,
    "js/ts.suggest.jsdoc.generateReturns": true,
    "js/ts.suggestionActions.enabled": true,
    "js/ts.updateImportsOnFileMove.enabled": "always",
    "js/ts.updateImportsOnPaste.enabled": true,
    "js/ts.validate.enabled": true,
    "json.schemaDownload.enable": true,
    "json.schemaDownload.trustedDomains": {
      "https://biomejs.dev": true,
      "https://developer.microsoft.com/json-schemas/": true,
      "https://json-schema.org/": true,
      "https://json.schemastore.org/": true,
      "https://raw.githubusercontent.com/devcontainers/spec/": true,
      "https://raw.githubusercontent.com/microsoft/vscode/": true,
      "https://schemastore.azurewebsites.net/": true,
      "https://www.schemastore.org/": true
    },
    "prettier.arrowParens": "always",
    "prettier.bracketSameLine": false,
    "prettier.bracketSpacing": true,
    "prettier.documentSelectors": [
      "**/*.astro",
      "**/*.css",
      "**/*.html",
      "**/*.js",
      "**/*.json",
      "**/*.jsonc",
      "**/*.jsx",
      "**/*.md",
      "**/*.mdx",
      "**/*.scss",
      "**/*.ts",
      "**/*.tsx",
      "**/*.vue",
      "**/*.yaml",
      "**/*.yml"
    ],
    "prettier.embeddedLanguageFormatting": "auto",
    "prettier.enable": true,
    "prettier.enableDebugLogs": false,
    "prettier.endOfLine": "lf",
    "prettier.experimentalOperatorPosition": "end",
    "prettier.experimentalTernaries": false,
    "prettier.htmlWhitespaceSensitivity": "css",
    "prettier.ignorePath": ".prettierignore",
    "prettier.insertPragma": false,
    "prettier.jsxSingleQuote": false,
    "prettier.objectWrap": "preserve",
    "prettier.printWidth": 80,
    "prettier.proseWrap": "preserve",
    "prettier.quoteProps": "as-needed",
    "prettier.requireConfig": false,
    "prettier.requirePragma": false,
    "prettier.resolveGlobalModules": false,
    "prettier.semi": true,
    "prettier.singleAttributePerLine": false,
    "prettier.singleQuote": false,
    "prettier.tabWidth": 2,
    "prettier.trailingComma": "none",
    "prettier.useEditorConfig": true,
    "prettier.useTabs": false,
    "prettier.vueIndentScriptAndStyle": false,
    "prettier.withNodeModules": false,
    "tailwindCSS.classAttributes": [
      "class",
      "className",
      "ngClass",
      "class:list"
    ],
    "tailwindCSS.codeActions": true,
    "tailwindCSS.codeLens": true,
    "tailwindCSS.colorDecorators": true,
    "tailwindCSS.emmetCompletions": true,
    "tailwindCSS.hovers": true,
    "tailwindCSS.lint.cssConflict": "warning",
    "tailwindCSS.lint.deprecatedAtRule": "warning",
    "tailwindCSS.lint.invalidApply": "error",
    "tailwindCSS.lint.invalidConfigPath": "error",
    "tailwindCSS.lint.invalidScreen": "error",
    "tailwindCSS.lint.invalidTailwindDirective": "error",
    "tailwindCSS.lint.invalidVariant": "error",
    "tailwindCSS.lint.recommendedVariantOrder": "warning",
    "tailwindCSS.lint.suggestCanonicalClasses": "warning",
    "tailwindCSS.lint.usedBlocklistedClass": "warning",
    "tailwindCSS.rootFontSize": 16,
    "tailwindCSS.showPixelEquivalents": true,
    "tailwindCSS.suggestions": true,
    "tailwindCSS.validate": true,
    "tailwindcss-intellisense.trace.server": "messages",
    "window.density.layout": "compact",
    "window.zoomLevel": 1.2,
    "workbench.activityBar.compact": true,
    "workbench.activityBar.location": "bottom",
    "workbench.colorTheme": "GitHub Dark Colorblind (Beta)",
    "workbench.iconTheme": "material-icon-theme"
  }
}
