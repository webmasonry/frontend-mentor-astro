{
  "author": "Matthew Mason",
  "description": "Astro Toolbar Integration for CSS Debugging",
  "exports": {
    ".": "./dist/integration.js",
    "./app": "./dist/app.js"
  },
  "files": ["./dist", "./package.json", "./src"],
  "keywords": [
    "AstroJS",
    "AstroJS Integration",
    "AstroJS Toolbar",
    "AstroJS Toolbar Integration",
    "AstroJS CSS Debugger"
  ],
  "license": "ISC",
  "name": "astro-css-debugger",
  "private": true,
  "scripts": {
    "build": "tsc && node --input-type=module -e \"import{cpSync}from'node:fs';cpSync('src/assets','dist/assets',{recursive:true})\"",
    "dev": "tsc --watch",
    "prepublish": "npm run build"
  },
  "type": "module",
  "version": "1.0.0"
}
